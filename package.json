{
    "name": "template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.22.2"
    },
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev",
        "start": "react-router-serve ./build/server/index.js",
        "typecheck": "react-router typegen && tsc",
        "lint:style": "stylelint \"src/**/*.css\" --max-warnings 0 --report-needless-disables --report-invalid-scope-disables --report-descriptionless-disables",
        "lint:style:fix": "stylelint \"src/**/*.css\" --fix",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "verify": "npm run typecheck && npm run lint && npm run lint:style && npm run format:check",
        "check:audit": "node scripts/check-audit.mjs"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix --cache --cache-strategy content --no-warn-ignored",
            "prettier --write --ignore-unknown --cache"
        ],
        "*.css": [
            "stylelint --fix --allow-empty-input",
            "prettier --write --ignore-unknown --cache"
        ],
        "*.{js,mjs,cjs,json,md,html,yml,yaml}": [
            "prettier --write --ignore-unknown --cache"
        ]
    },
    "dependencies": {
        "@react-router/node": "^8.5.2",
        "@react-router/serve": "^8.5.2",
        "isbot": "^5.2.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@react-router/dev": "^8.5.2",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "prettier": "^3.10.1",
        "stylelint": "^18.1.0",
        "stylelint-config-recess-order": "^7.10.1",
        "stylelint-config-standard": "^41.1.0",
        "stylelint-order": "^8.1.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.26.1",
        "vite": "^8.3.8",
        "vite-tsconfig-paths": "^6.1.1"
    }
}
