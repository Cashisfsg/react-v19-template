# Dependencies
node_modules/

# Build output
/build/
dist/
dist-ssr/

# React Router generated types
/.react-router/

# Vite: config bundled while loading, removed on a clean exit
vite.config.*.timestamp-*

# Environment. The example file documents the variables, so it is tracked.
.env
.env.*
!.env.example
*.local

# Tool caches
.eslintcache
.stylelintcache
*.tsbuildinfo
.cache/

# Test output
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors. Only the recommended VS Code extensions are shared.
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace
*.sw?

# OS
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
